{
  "name": "arb-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Arbitrage with CrossEx \u2014 delta-neutral funding-rate arbitrage on Gate CrossEx (web terminal + Fastify server)",
  "license": "MIT",
  "repository": "github:mage1028/arbitrage-with-crossex",
  "packageManager": "yarn@1.22.22",
  "supplyChain": {
    "yarnTarballSha256": "c17d3797fb9a9115bf375e31bfd30058cac6bc9c3b8807a3d8cb2094794b51ca"
  },
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project server",
    "test:watch": "vitest --project unit --project server",
    "test:web": "yarn --cwd web test",
    "test:live:smoke": "LIVE_TRADE_TESTS=1 SMOKE=1 vitest run --project live tests/live/engine-smoke.test.ts --reporter=verbose",
    "test:live": "LIVE_TRADE_TESTS=1 vitest run --project live --reporter=verbose",
    "live:cleanup": "tsx tests/live/cleanup.ts",
    "server": "tsx src/server/index.ts",
    "dev": "concurrently -n server,web -c blue,magenta \"tsx watch src/server/index.ts\" \"yarn --cwd web dev\"",
    "start": "yarn --cwd web build && tsx src/server/index.ts",
    "verify:supply-chain": "node scripts/verify-supply-chain.mjs",
    "verify": "yarn verify:supply-chain && tsc --noEmit && yarn test && yarn --cwd web typecheck && yarn --cwd web test"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "axios": "1.18.1",
    "dotenv": "16.6.1",
    "fastify": "5.12.1",
    "gate-api": "7.2.78",
    "viem": "2.55.18"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "concurrently": "10.0.3",
    "nock": "14.0.16",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "8.1.3",
    "vitest": "4.1.9"
  },
  "resolutions": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "shell-quote": "1.9.0"
  }
}
